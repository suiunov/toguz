{
  "name": "toguz-capacitor",
  "version": "1.0.0",
  "description": "Web game wrapped as an Android/iOS app",
  "scripts": {
    "build": "node build.js",
    "sync": "node build.js && npx cap sync",
    "android": "node build.js && npx cap sync android && npx cap open android",
    "ios": "node build.js && npx cap sync ios && npx cap open ios",
    "icons": "npx capacitor-assets generate --iconBackgroundColor \"#8c1c24\" --splashBackgroundColor \"#8c1c24\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@fontsource/philosopher": "^5.3.0",
    "@fontsource/rubik": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.3"
  },
  "private": true
}
