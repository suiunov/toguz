{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('t').val() < now - 21600000 || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || !data.child('guest').exists())",
        ".validate": "newData.child('host').isString() && newData.child('t').isNumber()",
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "guestName": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "moves": { "$n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 18 && !data.exists()" } },
        "here": { "$p": { ".validate": "newData.isBoolean()" } },
        "left": { "$p": { ".validate": "newData.isBoolean()" } }
      }
    }
  }
}
